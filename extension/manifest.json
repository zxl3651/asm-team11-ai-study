{
  "manifest_version": 3,
  "name": "소마 메이트 (SoMa Mate)",
  "version": "1.0.0",
  "description": "소프트웨어 마에스트로 부산 연수생을 위한 AI 멘토·멘토링 탐색 비서",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://swmaestro.ai/*",
    "http://localhost:8000/*"
  ]
}
