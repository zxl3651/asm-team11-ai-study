{
  "manifest_version": 3,
  "name": "소마 메이트 (SoMa Mate)",
  "version": "0.1.0",
  "description": "소마 연수생을 위한 에이전트형 멘토·멘토링 탐색 도우미",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": {
    "default_title": "소마 메이트 열기"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
